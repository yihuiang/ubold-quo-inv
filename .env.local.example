# Copy this file to  .env.local  and fill in your Turso values.
# Get these from the Turso dashboard (turso.tech) or the Turso CLI.
# Used for local `vercel dev`. On Vercel itself, set the SAME two
# variables in Project Settings -> Environment Variables.

TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-long-auth-token-here
